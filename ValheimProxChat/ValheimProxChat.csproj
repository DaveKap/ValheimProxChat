<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>ValheimProxChat</AssemblyName>
    <RootNamespace>ValheimProxChat</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>ValheimProxChat Contributors</Authors>
    <Description>Proximity voice chat mod for Valheim</Description>
  </PropertyGroup>

  <!--
    Valheim modding references.

    Set VALHEIM_INSTALL before building, or create Environment.props next to this file:

      set VALHEIM_INSTALL=C:\Program Files (x86)\Steam\steamapps\common\Valheim
      dotnet build -c Release

    Or create Environment.props:
      <Project><PropertyGroup>
        <ValheimInstall>C:\Program Files (x86)\Steam\steamapps\common\Valheim</ValheimInstall>
      </PropertyGroup></Project>
  -->

  <Import Project="Environment.props" Condition="Exists('Environment.props')" />

  <PropertyGroup>
    <ValheimInstall Condition="'$(ValheimInstall)' == ''">$(VALHEIM_INSTALL)</ValheimInstall>
    <ValheimManaged>$(ValheimInstall)\valheim_Data\Managed</ValheimManaged>
    <BepInExDir>$(ValheimInstall)\BepInEx\core</BepInExDir>
  </PropertyGroup>

  <Target Name="CheckValheimInstall" BeforeTargets="ResolveAssemblyReferences">
    <Error Text="VALHEIM_INSTALL is not set. Set the environment variable or create Environment.props. Example: set VALHEIM_INSTALL=C:\Program Files (x86)\Steam\steamapps\common\Valheim"
           Condition="'$(ValheimInstall)' == ''" />
  </Target>

  <!--
    Add Managed and BepInEx dirs as assembly search paths so MSBuild can
    resolve transitive dependencies between Unity DLLs automatically.
  -->
  <PropertyGroup>
    <AssemblySearchPaths>$(AssemblySearchPaths);$(ValheimManaged);$(BepInExDir)</AssemblySearchPaths>
  </PropertyGroup>

  <ItemGroup>
    <!-- BepInEx -->
    <Reference Include="BepInEx">
      <HintPath>$(BepInExDir)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Unity Engine (from valheim_Data\Managed) -->
    <Reference Include="UnityEngine">
      <HintPath>$(ValheimManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ValheimManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(ValheimManaged)\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ValheimManaged)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ValheimManaged)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Valheim -->
    <Reference Include="assembly_valheim">
      <HintPath>$(ValheimManaged)\assembly_valheim.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_guiutils">
      <HintPath>$(ValheimManaged)\assembly_guiutils.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
